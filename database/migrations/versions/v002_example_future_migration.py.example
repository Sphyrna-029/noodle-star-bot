"""
Example future migration demonstrating how to add new columns.

This file is an example and not executed. Rename to v002_*.py to use.
"""

DESCRIPTION = "Add daily reward tracking columns"


def upgrade(cursor) -> None:
    """Apply the migration."""
    # Add new column for daily reward tracking
    cursor.execute("""
        ALTER TABLE noodle_stars
        ADD COLUMN last_daily TEXT
    """)

    # Add new column for streak tracking
    cursor.execute("""
        ALTER TABLE noodle_stars
        ADD COLUMN daily_streak INTEGER DEFAULT 0
    """)


def downgrade(cursor) -> None:
    """Rollback the migration."""
    # SQLite doesn't support DROP COLUMN easily
    # In practice, you'd recreate the table without the columns
    # For development, this shows the intent
    pass
